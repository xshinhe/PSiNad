set(ENV{PSND_INCLUDE_PATH} "@WRAPPER_INCLUDE_DIRS@")
set(ENV{PSND_LIB_PATH} "@CMAKE_INSTALL_PREFIX@/lib")
message("PSND_LIB_PATH = " $ENV{PSND_LIB_PATH})
message("PSND_INCLUDE_PATH = " $ENV{PSND_INCLUDE_PATH})
execute_process(
    COMMAND "@PYTHON_EXECUTABLE@" setup.py @PYTHON_SETUP_COMMAND@
    WORKING_DIRECTORY "@PYTHON_PACKAGE_DIR@"
)
